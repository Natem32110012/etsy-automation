# Replicate — konsept/metin üretimi (gemini-2.5-flash) ve görsel üretimi (gpt-image-2)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsiyonel model override
REPLICATE_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
REPLICATE_TEXT_MODEL=google/gemini-2.5-flash

# Opsiyonel görsel kalitesi: low | medium | high | auto
# Kalite normalde arayüzden seçiliyor; bu değişken sadece arayüzden seçim
# gelmediğinde devreye giren yedek. Hiç tanımlı değilse ürün "high", promo "medium".
# REPLICATE_IMAGE_QUALITY=high

# --- Pinterest API v5 ---
# Business hesap + claim edilmiş Etsy mağaza domaini gerekiyor.
# Token yoksa Pinterest adımı "dry-run" çalışır: metinler üretilir, pin atılmaz.
PINTEREST_ACCESS_TOKEN=
# Sandbox denemesi için: https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5

# Ürün tipine göre board eşleştirmesi
BOARD_ID_DOODLE=
BOARD_ID_COLORING=
BOARD_ID_PLANNER=
BOARD_ID_INVITATION=
BOARD_ID_PARTY=
BOARD_ID_PAPERDOLL=

# --- Etsy Open API v3 (Seller App) ---
# Token asla koda yazılmaz. OAuth sonrası access/refresh data/etsy/tokens.json.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3001/api/etsy/callback
ETSY_SHOP_ID=
